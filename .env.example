# ─────────────────────────────────────────────────────────────────────────────
# Andy Clip — configuración por variables de entorno (opcional)
#
# La app guarda su configuración en .local/settings.json y las API keys en
# .local/secrets.json. Estas variables siguen funcionando para la CLI original
# y como fallback avanzado.
#
# Precedencia: configuración guardada por la app  >  variables de entorno  >  defaults
# ─────────────────────────────────────────────────────────────────────────────

# ── Modo local (predeterminado en Andy Clip) ─────────────────────────────────
LLM_PROVIDER=openai           # openai o gemini
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

LOCAL_WHISPER_MODEL=base      # tiny / base / small / medium / large-v3
LOCAL_WHISPER_DEVICE=auto     # auto / cpu / cuda
LOCAL_WHISPER_VAD_FILTER=false
LOCAL_OUTPUT_DIR=output

# ── Modo MuAPI (servicio externo opcional, compatibilidad con upstream) ──────
MUAPI_API_KEY=your_muapi_key_here
# MUAPI_BASE_URL=https://api.muapi.ai/api/v1
# MUAPI_POLL_INTERVAL=5
# MUAPI_POLL_TIMEOUT=600

# ── Servidor local de Andy Clip ──────────────────────────────────────────────
# ANDY_CLIP_HOST=127.0.0.1
# ANDY_CLIP_PORT=8756
# ANDY_CLIP_LOG_LEVEL=info
